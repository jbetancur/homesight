[Unit]
Description=HomeSight Home Monitoring Daemon
After=network.target mosquitto.service
Wants=homesight-ai.service

[Service]
Type=simple
User=homesight
Group=homesight
WorkingDirectory=/usr/local/bin
ExecStart=/usr/local/bin/homesightd
Restart=on-failure
RestartSec=10
Environment="HOMESIGHT_CONFIG=/etc/homesight/config.yaml"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/homesight

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homesightd

[Install]
WantedBy=multi-user.target
