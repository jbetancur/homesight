# Development Dockerfile for hot-reloading with npm run dev
FROM node:25-alpine

WORKDIR /app

# Copy package files first for better caching
COPY web-ui/package.json web-ui/package-lock.json ./

# Install dependencies
RUN npm ci

# Source code will be mounted as a volume for hot-reloading
# Node modules are in a named volume to avoid conflicts with host

EXPOSE 5173

CMD ["npm", "run", "dev"]
