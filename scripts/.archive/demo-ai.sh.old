#!/bin/bash
# Demo AI features of HomeSight

API_URL="http://localhost:8080"
AI_URL="http://localhost:8001"

# Colors
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║       🤖 HomeSight AI Demo                               ║${NC}"
echo -e "${CYAN}║       AI-Powered Incident Analysis                       ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}"
echo ""

# Check if AI sidecar is running
echo -e "${GREEN}Checking AI sidecar status...${NC}"
AI_STATUS=$(curl -s $AI_URL/health 2>/dev/null)
if [ $? -eq 0 ]; then
    echo "$AI_STATUS" | python3 -m json.tool 2>/dev/null
    echo -e "${GREEN}✓ AI sidecar is running${NC}"
else
    echo -e "${RED}✗ AI sidecar not running. Start it with:${NC}"
    echo -e "${YELLOW}  cd ai-sidecar && source venv/bin/activate && python main.py${NC}"
    exit 1
fi

echo ""
echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}Demo 1: Chat Interface${NC}"
echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
echo ""

# Demo 1: General home maintenance questions
echo -e "${YELLOW}Question 1: How do I prevent frozen pipes?${NC}"
curl -s -X POST $AI_URL/chat \
  -H "Content-Type: application/json" \
  -d '{
    "message": "How do I prevent frozen pipes in winter?"
  }' | python3 -c "import sys, json; resp=json.load(sys.stdin); print('\nAI Response:', resp['response']); print('\nSuggestions:'); [print(f'  • {s}') for s in resp.get('suggestions', [])]" 2>/dev/null

echo ""
echo -e "${YELLOW}Question 2: What should I do about a water leak?${NC}"
curl -s -X POST $AI_URL/chat \
  -H "Content-Type: application/json" \
  -d '{
    "message": "My leak sensor detected water. What should I do?",
    "context": {
      "location": "basement",
      "severity": "critical"
    }
  }' | python3 -c "import sys, json; resp=json.load(sys.stdin); print('\nAI Response:', resp['response']); print('\nSuggestions:'); [print(f'  • {s}') for s in resp.get('suggestions', [])]" 2>/dev/null

echo ""
echo ""
echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}Demo 2: Incident Analysis${NC}"
echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
echo ""

# Demo 2: Analyze different incident types
echo -e "${YELLOW}Analyzing: Water Leak Incident${NC}"
curl -s -X POST $AI_URL/analyze \
  -H "Content-Type: application/json" \
  -d '{
    "type": "incident",
    "data": {
      "type": "leak_detected",
      "severity": "critical",
      "location": "basement"
    },
    "context": {
      "device": "water_leak_sensor",
      "last_maintenance": "2024-06-15"
    }
  }' | python3 -c "import sys, json; resp=json.load(sys.stdin); print('\nAnalysis:', resp['analysis']); print('\nInsights:'); [print(f'  • {i}') for i in resp.get('insights', [])]; print('\nRecommended Actions:'); [print(f'  {idx+1}. {a}') for idx, a in enumerate(resp.get('actions', []))]" 2>/dev/null

echo ""
echo ""
echo -e "${YELLOW}Analyzing: Freeze Risk Incident${NC}"
curl -s -X POST $AI_URL/analyze \
  -H "Content-Type: application/json" \
  -d '{
    "type": "incident",
    "data": {
      "type": "freeze_risk",
      "severity": "high",
      "temperature": 32.5,
      "location": "attic"
    }
  }' | python3 -c "import sys, json; resp=json.load(sys.stdin); print('\nAnalysis:', resp['analysis']); print('\nInsights:'); [print(f'  • {i}') for i in resp.get('insights', [])]; print('\nRecommended Actions:'); [print(f'  {idx+1}. {a}') for idx, a in enumerate(resp.get('actions', []))]" 2>/dev/null

echo ""
echo ""
echo -e "${YELLOW}Analyzing: Excessive Sump Pump Activity${NC}"
curl -s -X POST $AI_URL/analyze \
  -H "Content-Type: application/json" \
  -d '{
    "type": "incident",
    "data": {
      "type": "sump_pump_excessive",
      "severity": "high",
      "cycle_count": 45,
      "period": "1h"
    }
  }' | python3 -c "import sys, json; resp=json.load(sys.stdin); print('\nAnalysis:', resp['analysis']); print('\nInsights:'); [print(f'  • {i}') for i in resp.get('insights', [])]; print('\nRecommended Actions:'); [print(f'  {idx+1}. {a}') for idx, a in enumerate(resp.get('actions', []))]" 2>/dev/null

echo ""
echo ""
echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}Demo 3: Metrics Analysis${NC}"
echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
echo ""

# Demo 3: Analyze sensor metrics
echo -e "${YELLOW}Analyzing: Temperature Sensor Readings${NC}"
curl -s -X POST $AI_URL/analyze \
  -H "Content-Type: application/json" \
  -d '{
    "type": "metrics",
    "data": {
      "sensor_id": "basement-temp-001",
      "values": [68.5, 67.2, 66.8, 45.3, 66.5, 67.1, 68.0],
      "timerange": "last_24h"
    }
  }' | python3 -c "import sys, json; resp=json.load(sys.stdin); print('\nAnalysis:', resp['analysis']); print('\nInsights:'); [print(f'  • {i}') for i in resp.get('insights', [])]; print('\nRecommended Actions:'); [print(f'  {idx+1}. {a}') for idx, a in enumerate(resp.get('actions', []))]" 2>/dev/null

echo ""
echo ""
echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}Demo 4: AI via Main API (Proxy)${NC}"
echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
echo ""

# Demo 4: Access AI through main API
echo -e "${YELLOW}Using main API proxy endpoint${NC}"
curl -s -X POST $API_URL/ai/chat \
  -H "Content-Type: application/json" \
  -d '{
    "message": "What maintenance should I do before winter?"
  }' | python3 -c "import sys, json; resp=json.load(sys.stdin); print('\nAI Response:', resp['response'])" 2>/dev/null

echo ""
echo ""
echo -e "${GREEN}╔══════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║                    Demo Complete! 🎉                     ║${NC}"
echo -e "${GREEN}╚══════════════════════════════════════════════════════════╝${NC}"
echo ""
echo -e "${CYAN}AI Features Demonstrated:${NC}"
echo "  ✓ Chat interface for home maintenance questions"
echo "  ✓ Incident analysis with actionable recommendations"
echo "  ✓ Metrics anomaly detection"
echo "  ✓ Context-aware responses"
echo "  ✓ API proxy endpoints"
echo ""
echo -e "${YELLOW}Note: Currently using rule-based fallback responses.${NC}"
echo -e "${YELLOW}For enhanced AI, install a GGUF model in /var/lib/homesight/models/${NC}"
echo ""
